{
  "name": "sc8p053vm",
  "version": "1.0.5",
  "description": "SC8P053 microcontroller virtual machine simulator",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "cd example && webpack serve --mode development",
    "test": "jest",
    "test:example": "jest --config example/jest.config.js",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:src": "eslint src/ --ext .ts",
    "lint:example": "eslint example/ --ext .tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\""
  },
  "keywords": [
    "sc8p053",
    "microcontroller",
    "vm",
    "simulator",
    "virtual-machine",
    "embedded",
    "assembly",
    "emulator"
  ],
  "author": "zycwind",
  "homepage": "https://github.com/zycwind/sc8p053vm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zycwind/sc8p053vm.git"
  },
  "peerDependencies": {
    "tree-sitter-c": "^0.23.1",
    "web-tree-sitter": "^0.24.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "css-loader": "^7.1.4",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.8.3",
    "react-dom": "^18.3.1",
    "style-loader": "^4.0.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c": "^0.23.1",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "react": "^18.2.0"
  }
}
